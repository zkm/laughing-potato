{
    "name": "sweetwater/test-project",
    "description": "Sweetwater Web Programmer Test Project",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Sweetwater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sweetwater\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "install-deps": "composer install --no-dev --optimize-autoloader"
    }
}
